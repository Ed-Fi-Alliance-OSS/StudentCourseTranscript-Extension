root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[**/*.md]
trim_trailing_whitespace = false

[*.{js,json,yml}]
file_header_template = SPDX-License-Identifier: Apache-2.0
indent_size = 2

[*.{ps1,psm1}]
file_header_template = SPDX-License-Identifier: Apache-2.0
indent_size = 4

[*.metaed]
file_header_template = SPDX-License-Identifier: Apache-2.0
indent_size = 4
